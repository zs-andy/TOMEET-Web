# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Temporarily disabled public features. Set to true to restore them.
NEXT_PUBLIC_FOODIES_ENABLED=false
NEXT_PUBLIC_QR_SERVICE_ENABLED=false

# Railway API (no trailing slash, server-side only)
TOMEET_API_BASE_URL=https://your-api.up.railway.app

# Existing deployments may keep this as a backward-compatible fallback:
# NEXT_PUBLIC_API_BASE_URL=https://your-api.up.railway.app
